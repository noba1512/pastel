SECRET_KEY=troque-esta-chave-em-producao
DEBUG=1
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# sqlite | postgres
DB_ENGINE=sqlite
# No Docker o compose define SQLITE_PATH=/app/data/db.sqlite3
# Fora do Docker, deixe vazio para usar data/db.sqlite3
# SQLITE_PATH=

# Usado somente quando DB_ENGINE=postgres
DB_NAME=pastel
DB_USER=pastel
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Cabeçalho do comprovante térmico (80mm)
STORE_NAME=Pastel da TATI
STORE_DOCUMENT=
STORE_ADDRESS=
STORE_PHONE=
STORE_FOOTER=Obrigado. Volte sempre.

# Impressora térmica ESC/POS. Vazio = cupom no terminal/spool.
# Rede (porta 9100): THERMAL_PRINTER_HOST=192.168.0.50
THERMAL_PRINTER_HOST=
THERMAL_PRINTER_PORT=9100
THERMAL_AGENT_URL=http://host.docker.internal:9101/print
